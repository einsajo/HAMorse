# Copy this file to .env and fill it in. .env is git-ignored: NEVER commit a real key
# (this repository is public). Run the route with:
#   node --env-file=.env server/agent-route.mjs
#
# Your Groq key (https://console.groq.com/keys):
AGENT_LLM_KEY=
# Defaults (the tested setup): Groq, qwen/qwen3.8-27b, one reply per turn, thinking off.
# AGENT_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# AGENT_LLM_MODEL=qwen/qwen3.8-27b
# AGENT_LLM_STREAM=false
# AGENT_ALLOWED_ORIGIN=https://your-site.example
# PORT=8787

# The app (Vite) reads only VITE_* variables, so the key above never reaches the browser.
# Point the app at the route (leave it empty to use the offline local brains):
VITE_AGENT_URL=http://localhost:8787/agent
