# Copy this file to .env and fill it in. .env is git-ignored: never commit a real key.
#
# The agent route (server/agent-route.mjs) reads these:
#   node --env-file=.env server/agent-route.mjs
AGENT_LLM_KEY=
# Defaults: Google Gemini through its OpenAI-compatible endpoint.
# AGENT_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AGENT_LLM_MODEL=gemini-3.8-flash
# AGENT_ALLOWED_ORIGIN=https://your-site.example
# PORT=8787

# The app (Vite) reads VITE_* variables. Point it at the route:
VITE_AGENT_URL=http://localhost:8787/agent
